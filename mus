  const generateGraphData = (items, selectedId = null) => {
    const nodes = [];
    const links = [];

    const traverse = (entries, parentId = null, depth = 0, index = 0) => {
      entries.forEach((node, idx) => {
        const nodeDepth = depth + 1;
        const offset = (idx - (entries.length - 1) / 2) * 110;
        const graphNode = {
          id: node.id,
          name: node.name,
          type: node.type,
          color: node.type === 'folder' ? '#3b82f6' : '#67e8f9',
          x: parentId ? (nodeDepth * 170 + ((index + 1) * 8)) : 140,
          y: parentId ? (offset + (index * 34)) : (idx - 1) * 140,
          val: 4,
        };

        nodes.push(graphNode);
        if (parentId) links.push({ source: parentId, target: node.id });

        if (node.children?.length) traverse(node.children, node.id, nodeDepth, idx + index + 1);
      });
    };

    traverse(items);

    const degree = new Map();
    links.forEach(({ source, target }) => {
      degree.set(source, (degree.get(source) || 0) + 1);
      degree.set(target, (degree.get(target) || 0) + 1);
    });

    nodes.forEach((node) => {
      node.val = Math.max(4, (degree.get(node.id) || 0) * 2 + 2);
    });

    if (!selectedId) return { nodes, links };

    const connected = new Set([selectedId]);
    links.forEach(({ source, target }) => {
      if (source === selectedId) connected.add(target);
      if (target === selectedId) connected.add(source);
    });

    return {
      nodes: nodes.filter((node) => connected.has(node.id)),
      links: links.filter((link) => connected.has(link.source) && connected.has(link.target)),
    };
  };

  const GraphPage = () => {
    const [selectedNode, setSelectedNode] = useState(null);
    const [hoveredNode, setHoveredNode] = useState(null);
    const [searchTerm, setSearchTerm] = useState('');
    const [isLocalGraph, setIsLocalGraph] = useState(false);

    const graphData = generateGraphData(fileTree, isLocalGraph && selectedNode ? selectedNode.id : null);
    const nodeMap = new Map(graphData.nodes.map(node => [node.id, node]));
    const connectedNodeIds = new Set();

    if (hoveredNode) {
      connectedNodeIds.add(hoveredNode.id);
      graphData.links.forEach(({ source, target }) => {
        if (source === hoveredNode.id || target === hoveredNode.id) {
          connectedNodeIds.add(source);
          connectedNodeIds.add(target);
        }
      });
    }

    const normalizedSearch = searchTerm.trim().toLowerCase();

    return (
      <div className="space-y-6">
        <div className="flex items-start justify-between gap-4">
          <div>
