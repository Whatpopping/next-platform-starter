    await new Promise(resolve => setTimeout(resolve, 1000));
    
    const mockResults = [
      { id: 1, title: `${query} - Official Music Video`, artist: "Artist Name", duration: "3:45", thumbnail: "https://via.placeholder.com/60x60/8B5CF6/FFFFFF?text=♪" },
