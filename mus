import React, { useMemo, useState } from 'react';
import {
  ArrowDownRight,
  ArrowUpRight,
  Bitcoin,
  Bot,
  Copy,
  DollarSign,
  Megaphone,
  ShieldCheck,
  Sparkles,
  Target,
  TrendingUp,
  Wallet,
} from 'lucide-react';

const SATS_PER_BTC = 100_000_000;
// Deliberately unset: this prototype must never present a made-up address as a real wallet.
const AGENT_BTC_ADDRESS = '';

const marketSignals = [
  {
    label: 'Audience demand',
    value: 82,
    tone: 'emerald',
    insight: 'Illustrative demo signal. Connect a verified analytics/search data source before treating this as live intelligence.',
  },
  {
    label: 'Bitcoin momentum',
    value: 64,
    tone: 'amber',
    insight: 'Illustrative demo signal. A production implementation should identify its market-data source and timestamp.',
  },
  {
    label: 'Cash runway',
    value: 91,
    tone: 'sky',
    insight: 'Illustrative demo signal. Production runway should be calculated from verified cash-flow and expense data.',
  },
];

const campaignIdeas = [
  {
    name: 'Creator launch sprint',
    spend: '$4,800',
    projectedReturn: '$13,900',
    roi: '190%',
    channel: 'Short-form video + affiliate links',
  },
  {
    name: 'Retargeting profit loop',
    spend: '$2,200',
    projectedReturn: '$5,950',
    roi: '170%',
    channel: 'Pixel audiences + email capture',
  },
  {
    name: 'Bitcoin education funnel',
    spend: '$1,400',
    projectedReturn: '$3,250',
    roi: '132%',
    channel: 'Lead magnet + webinar replay',
  },
];

const tradingRules = [
  {
    action: 'Buy',
    trigger: 'DCA when BTC trades below the 30-day trend and campaign cash flow is positive.',
    allocation: '25% of weekly net profit',
    icon: ArrowDownRight,
  },
  {
    action: 'Hold',
    trigger: 'Keep reserves untouched while marketing CAC is below target payback period.',
    allocation: 'Core treasury stack',
    icon: ShieldCheck,
  },
  {
    action: 'Sell',
    trigger: 'Take profit when BTC is 18% above cost basis or ad spend needs liquidity.',
    allocation: 'Up to 15% of vault',
    icon: ArrowUpRight,
  },
];

const formatCurrency = (value) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);

const AgentMarketingTool = () => {
  const [btcPrice, setBtcPrice] = useState(112000);
  const [weeklyProfit, setWeeklyProfit] = useState(12500);
  const [riskLevel, setRiskLevel] = useState('Balanced');
  const [copied, setCopied] = useState(false);
  const [copyError, setCopyError] = useState(false);

  const plan = useMemo(() => {
    const safeBtcPrice = Number.isFinite(btcPrice) && btcPrice > 0 ? btcPrice : 1;
    const safeWeeklyProfit = Number.isFinite(weeklyProfit) && weeklyProfit >= 0 ? weeklyProfit : 0;
    const allocationRate = riskLevel === 'Aggressive' ? 0.4 : riskLevel === 'Defensive' ? 0.15 : 0.25;
    const takeProfitMultiplier = riskLevel === 'Aggressive' ? 1.22 : riskLevel === 'Defensive' ? 1.12 : 1.18;
    const stopLossMultiplier = riskLevel === 'Aggressive' ? 0.86 : riskLevel === 'Defensive' ? 0.94 : 0.9;
    const buyBudget = safeWeeklyProfit * allocationRate;
    const btcToBuy = buyBudget / safeBtcPrice;
    const satsToBuy = Math.round(btcToBuy * SATS_PER_BTC);
    const takeProfitPrice = safeBtcPrice * takeProfitMultiplier;
    const stopLossPrice = safeBtcPrice * stopLossMultiplier;

    return {
      buyBudget,
      btcToBuy,
      satsToBuy,
      takeProfitPrice,
      stopLossPrice,
    };
  }, [btcPrice, weeklyProfit, riskLevel]);

  const copyAddress = async () => {
    if (!AGENT_BTC_ADDRESS || !navigator.clipboard?.writeText) {
      setCopyError(true);
      setCopied(false);
      return;
    }

    try {
      await navigator.clipboard.writeText(AGENT_BTC_ADDRESS);
      setCopied(true);
      setCopyError(false);
      setTimeout(() => setCopied(false), 1800);
    } catch {
      setCopied(false);
      setCopyError(true);
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-white">
      <div className="absolute inset-0 overflow-hidden">
        <div className="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-orange-500/20 blur-3xl" />
        <div className="absolute right-0 top-64 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl" />
      </div>

      <main className="relative mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <nav className="mb-12 flex items-center justify-between rounded-3xl border border-white/10 bg-white/5 p-4 backdrop-blur">
          <div className="flex items-center gap-3">
            <div className="rounded-2xl bg-orange-500 p-3 text-slate-950">
              <Bot size={28} />
            </div>
            <div>
              <h1 className="text-xl font-black tracking-tight">Satoshi Growth Agent</h1>
              <p className="text-sm text-slate-400">AI marketing ops with a Bitcoin treasury plan</p>
            </div>
          </div>
          <button className="hidden rounded-full bg-white px-5 py-2 font-bold text-slate-950 transition hover:bg-orange-200 md:block">
            Launch agent
          </button>
        </nav>

        <section className="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div>
            <div className="mb-5 inline-flex items-center gap-2 rounded-full border border-orange-400/30 bg-orange-400/10 px-4 py-2 text-sm font-semibold text-orange-200">
              <Sparkles size={16} /> Autonomous campaign planning + BTC profit rules
            </div>
            <h2 className="max-w-4xl text-5xl font-black leading-tight tracking-tight md:text-7xl">
              Turn marketing profits into a disciplined Bitcoin strategy.
            </h2>
            <p className="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
              This prototype agent forecasts campaign ROI, models a share of weekly profit for Bitcoin, and explains when it plans to buy, hold, or sell. It is a planning dashboard only, not financial advice or an automated trading system.
            </p>
            <div className="mt-8 grid gap-4 sm:grid-cols-3">
              <Metric icon={Megaphone} label="Campaign ROI" value="Illustrative" />
              <Metric icon={Wallet} label="Vault address" value="Not configured" />
              <Metric icon={Target} label="Payback target" value="Illustrative" />
            </div>
          </div>

          <div className="rounded-[2rem] border border-white/10 bg-white/10 p-6 shadow-2xl backdrop-blur">
            <div className="mb-5 flex items-center justify-between">
              <div>
                <p className="text-sm uppercase tracking-[0.3em] text-slate-400">Agent wallet</p>
                <h3 className="text-2xl font-black">Bitcoin profit vault</h3>
              </div>
              <Bitcoin className="text-orange-400" size={44} />
            </div>
            <div className="rounded-3xl bg-slate-950/80 p-5">
              <p className="mb-2 text-sm text-slate-400">Dedicated receive address</p>
              <div className="break-all font-mono text-lg text-orange-200">
                {AGENT_BTC_ADDRESS || 'Not configured — demo only'}
              </div>
              <button
                onClick={copyAddress}
                disabled={!AGENT_BTC_ADDRESS}
                className="mt-4 flex w-full items-center justify-center gap-2 rounded-2xl bg-orange-500 px-4 py-3 font-black text-slate-950 transition hover:bg-orange-300 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-orange-500"
              >
                <Copy size={18} /> {copied ? 'Copied address' : 'Copy address'}
              </button>
              {copyError && (
                <p className="mt-2 text-sm text-amber-300" role="status">
                  Wallet address is not configured or could not be copied.
                </p>
              )}
            </div>
            <div className="mt-5 grid grid-cols-2 gap-4">
              <div className="rounded-3xl bg-emerald-400/10 p-4">
                <p className="text-sm text-emerald-200">Next planned buy</p>
                <p className="mt-2 text-2xl font-black">{plan.btcToBuy.toFixed(5)} BTC</p>
                <p className="text-sm text-slate-400">{plan.satsToBuy.toLocaleString()} sats</p>
              </div>
              <div className="rounded-3xl bg-cyan-400/10 p-4">
                <p className="text-sm text-cyan-200">Buy budget</p>
                <p className="mt-2 text-2xl font-black">{formatCurrency(plan.buyBudget)}</p>
                <p className="text-sm text-slate-400">from weekly net profit</p>
              </div>
              <div className="rounded-3xl bg-orange-400/10 p-4">
                <p className="text-sm text-orange-200">Take-profit alert</p>
                <p className="mt-2 text-2xl font-black">{formatCurrency(plan.takeProfitPrice)}</p>
                <p className="text-sm text-slate-400">review partial sell</p>
              </div>
              <div className="rounded-3xl bg-rose-400/10 p-4">
                <p className="text-sm text-rose-200">Risk floor</p>
                <p className="mt-2 text-2xl font-black">{formatCurrency(plan.stopLossPrice)}</p>
                <p className="text-sm text-slate-400">pause new buys</p>
              </div>
            </div>
          </div>
        </section>

        <section className="mt-10 grid gap-6 lg:grid-cols-3">
          <Control label="BTC price" value={btcPrice} min={60000} max={180000} step={1000} prefix="$" onChange={setBtcPrice} />
          <Control label="Weekly profit" value={weeklyProfit} min={1000} max={50000} step={500} prefix="$" onChange={setWeeklyProfit} />
          <div className="rounded-3xl border border-white/10 bg-white/5 p-5">
            <p className="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-slate-400">Risk mode</p>
            <div className="grid gap-2">
              {['Defensive', 'Balanced', 'Aggressive'].map((mode) => (
                <button
                  key={mode}
                  onClick={() => setRiskLevel(mode)}
                  className={`rounded-2xl px-4 py-3 text-left font-bold transition ${
                    riskLevel === mode ? 'bg-orange-500 text-slate-950' : 'bg-slate-900 text-slate-300 hover:bg-slate-800'
                  }`}
                >
                  {mode}
                </button>
              ))}
            </div>
          </div>
        </section>

        <section className="mt-10 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <div className="rounded-[2rem] border border-white/10 bg-white/5 p-6">
            <h3 className="mb-5 flex items-center gap-2 text-2xl font-black">
              <TrendingUp className="text-emerald-300" /> Profit-aware trade plan
            </h3>
            <p className="mb-4 text-sm text-slate-400">Prototype rules only — not a validated trading strategy.</p>
            <div className="space-y-4">
              {tradingRules.map(({ action, trigger, allocation, icon: Icon }) => (
                <div key={action} className="rounded-3xl bg-slate-900/80 p-5">
                  <div className="mb-2 flex items-center justify-between">
                    <span className="text-xl font-black">{action}</span>
                    <Icon className="text-orange-300" />
                  </div>
                  <p className="text-slate-300">{trigger}</p>
                  <p className="mt-3 text-sm font-bold text-orange-200">Allocation: {allocation}</p>
                </div>
              ))}
            </div>
          </div>

          <div className="rounded-[2rem] border border-white/10 bg-white/5 p-6">
            <div className="mb-5 flex items-center justify-between gap-4">
              <h3 className="text-2xl font-black">Marketing engine</h3>
              <span className="rounded-full bg-amber-400/10 px-3 py-1 text-xs font-bold text-amber-200">Illustrative demo data</span>
            </div>
            <div className="grid gap-4">
              {campaignIdeas.map((campaign) => (
                <div key={campaign.name} className="rounded-3xl bg-slate-900/80 p-5">
                  <div className="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h4 className="text-lg font-black">{campaign.name}</h4>
                      <p className="text-sm text-slate-400">{campaign.channel}</p>
                    </div>
                    <span className="rounded-full bg-emerald-400/10 px-3 py-1 text-sm font-black text-emerald-200">
                      {campaign.roi} illustrative ROI
                    </span>
                  </div>
                  <div className="mt-4 grid grid-cols-2 gap-3 text-sm">
                    <div className="rounded-2xl bg-white/5 p-3">
                      <p className="text-slate-400">Illustrative spend</p>
                      <p className="text-lg font-black">{campaign.spend}</p>
                    </div>
                    <div className="rounded-2xl bg-white/5 p-3">
                      <p className="text-slate-400">Illustrative return</p>
                      <p className="text-lg font-black">{campaign.projectedReturn}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section className="mt-10 grid gap-6 md:grid-cols-3">
          {marketSignals.map((signal) => (
            <div key={signal.label} className="rounded-3xl border border-white/10 bg-white/5 p-5">
              <div className="mb-3 flex items-center justify-between">
                <h4 className="font-black">{signal.label}</h4>
                <span className="font-mono text-sm">{signal.value}/100</span>
              </div>
              <div className="h-3 rounded-full bg-slate-800">
                <div className="h-3 rounded-full bg-orange-400" style={{ width: `${signal.value}%` }} />
              </div>
              <p className="mt-4 text-sm leading-6 text-slate-300">{signal.insight}</p>
            </div>
          ))}
        </section>

        <section className="mt-10 rounded-[2rem] border border-amber-300/20 bg-amber-300/10 p-6 text-amber-100">
          <div className="flex items-start gap-3">
            <DollarSign className="mt-1 shrink-0" />
            <p>
              Demo safeguard: connect real exchange, wallet, and ad-platform APIs only after adding custody,
              compliance, authentication, audit logs, and human approval workflows. No real Bitcoin address is
              configured in this prototype. Market signals, campaign returns, and trading thresholds shown here are
              illustrative and must not be treated as live financial data or validated performance projections.
            </p>
          </div>
        </section>
      </main>
    </div>
  );
};

const Metric = ({ icon: Icon, label, value }) => (
  <div className="rounded-3xl border border-white/10 bg-white/5 p-5">
    <Icon className="mb-4 text-orange-300" />
    <p className="text-sm text-slate-400">{label}</p>
    <p className="text-2xl font-black">{value}</p>
  </div>
);

const Control = ({ label, value, min, max, step, prefix, onChange }) => (
  <div className="rounded-3xl border border-white/10 bg-white/5 p-5">
    <div className="mb-4 flex items-center justify-between">
      <p className="text-sm font-bold uppercase tracking-[0.2em] text-slate-400">{label}</p>
      <p className="font-mono text-lg font-black">
        {prefix}
        {value.toLocaleString()}
      </p>
    </div>
    <input
      type="range"
      min={min}
      max={max}
      step={step}
      value={value}
      onChange={(event) => onChange(Number(event.target.value))}
      className="w-full accent-orange-500"
    />
  </div>
);

export default AgentMarketingTool;
