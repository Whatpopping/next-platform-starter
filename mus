            <p className="text-gray-400">Obsidian-style connections • Hover • Search • Local view</p>
          </div>
          <button
            onClick={() => setIsLocalGraph(!isLocalGraph)}
            className={`px-4 py-2 rounded-2xl text-sm transition-all ${
              isLocalGraph ? 'bg-blue-500 text-white' : 'bg-gray-800 hover:bg-gray-700 border border-gray-600'
            }`}
          >
            {isLocalGraph ? '← Global' : 'Local View'}
          </button>
        </div>

        <div className="relative">
          <input
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Search nodes..."
            className="w-full bg-gray-900 border border-gray-700 rounded-2xl px-4 py-3 text-sm focus:border-blue-500 focus:outline-none"
          />
        </div>

        <div className="rounded-2xl border border-gray-700 bg-black/60 p-4 overflow-auto">
          <svg viewBox="0 0 1200 620" className="w-full min-w-[800px] h-[620px]">
            <defs>
              <linearGradient id="linkGlow" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stopColor="#334155" />
                <stop offset="100%" stopColor="#64748b" />
              </linearGradient>
            </defs>
            <g transform="translate(80,310)">
              {graphData.links.map((link, idx) => {
                const source = nodeMap.get(link.source);
                const target = nodeMap.get(link.target);
                if (!source || !target) return null;
                const highlighted = hoveredNode && (link.source === hoveredNode.id || link.target === hoveredNode.id);
                return (
                  <g key={`link-${idx}`}>
                    <line x1={source.x} y1={source.y} x2={target.x} y2={target.y} stroke="url(#linkGlow)" strokeWidth={highlighted ? 2.5 : 1.2} opacity={highlighted ? 0.95 : 0.5} />
                    <circle r="2" fill="#93c5fd">
                      <animateMotion dur="2.6s" repeatCount="indefinite" path={`M ${source.x} ${source.y} L ${target.x} ${target.y}`} />
                    </circle>
                  </g>
                );
              })}

              {graphData.nodes.map((node) => {
                const isMatch = normalizedSearch && node.name.toLowerCase().includes(normalizedSearch);
                const dimmedBySearch = normalizedSearch && !isMatch;
                const highlighted = hoveredNode ? connectedNodeIds.has(node.id) : false;
                const isSelected = selectedNode?.id === node.id;
                const opacity = dimmedBySearch ? 0.2 : hoveredNode ? (highlighted ? 1 : 0.15) : 1;

                return (
                  <g key={node.id} transform={`translate(${node.x},${node.y})`} style={{ cursor: 'pointer', opacity }} onMouseEnter={() => setHoveredNode(node)} onMouseLeave={() => setHoveredNode(null)} onClick={() => setSelectedNode(node)}>
                    <circle r={node.val + (isSelected ? 5 : 0)} fill={isSelected || highlighted || isMatch ? '#a5f3fc' : node.color} className="drop-shadow-[0_0_8px_rgba(103,232,249,0.6)]" />
                    <text y={node.val + 18} textAnchor="middle" className="fill-gray-200 text-[11px] font-medium">{node.name}</text>
                  </g>
                );
              })}
            </g>
          </svg>
        </div>

        {selectedNode && (
          <div className="flex items-center justify-between rounded-xl bg-gray-900/80 border border-gray-700 px-4 py-3">
            <p className="text-sm text-gray-300">Selected: <span className="text-cyan-300">{selectedNode.name}</span></p>
            <button onClick={() => setSelectedNode(null)} className="text-xs px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-xl">Clear</button>
          </div>
        )}
      </div>
    );
  };

  const TreeNode = ({ node, level = 0, expandedNodes, toggleNode }) => {
    const isFolder = node.type === 'folder';
    const isExpanded = expandedNodes.has(node.id);

    return (
      <div className="relative">
        {level > 0 && (
          <div
            className="absolute top-0 bottom-0 border-l border-gray-700"
            style={{ left: `${(level - 1) * 20 + 19}px` }}
