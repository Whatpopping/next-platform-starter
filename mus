        )}
        <button
          onClick={() => toggleNode(node.id)}
          className="flex items-center w-full gap-2 rounded px-2 py-1.5 hover:bg-gray-800/70 transition-all active:bg-gray-700 text-sm"
          style={{ paddingLeft: `${level * 20 + 8}px` }}
        >
          {isFolder ? (
            isExpanded ?
              <ChevronDown size={16} className="text-gray-400" /> :
              <ChevronRight size={16} className="text-gray-400" />
