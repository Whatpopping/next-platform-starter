            <p className="text-gray-400">Interactive file structure explorer</p>
          </div>
          <div className="rounded-lg bg-blue-500/10 border border-blue-500/30 px-3 py-1.5 flex items-center gap-2 text-blue-400">
            <FolderTree size={16} />
