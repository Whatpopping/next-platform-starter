import React, { useEffect, useMemo, useState } from 'react';
import {
  Brain,
  Check,
  Copy,
  Lock,
  MessageSquare,
  Plus,
  Send,
  Settings,
  Share2,
  Sparkles,
} from 'lucide-react';

const STORAGE_KEY = 'multi-model-workspace-v2';

const defaultModels = [
  {
    id: 'openai-gpt-5',
    name: 'GPT-5',
    provider: 'OpenAI',
    maxContext: 200000,
    features: ['reasoning', 'tools', 'vision'],
  },
  {
    id: 'anthropic-claude-opus',
    name: 'Claude Opus',
    provider: 'Anthropic',
    maxContext: 200000,
    features: ['reasoning', 'coding', 'long-context'],
  },
  {
    id: 'google-gemini-2-5-pro',
    name: 'Gemini 2.5 Pro',
    provider: 'Google',
    maxContext: 1000000,
    features: ['reasoning', 'vision', 'audio', 'long-context'],
  },
];

const starterConversations = [
  {
    id: 'ctx-1',
    title: 'Support bot style guide',
    summary: 'Tone rules, compliance notes, and escalation policies.',
  },
  {
    id: 'ctx-2',
    title: 'Product roadmap Q2',
    summary: 'Feature priorities, launch dependencies, and risks.',
  },
  {
    id: 'ctx-3',
    title: 'Customer interview notes',
    summary: 'Pain points, desired outcomes, and objections.',
  },
];

const tagColors = {
  reasoning: 'bg-purple-600/30 text-purple-200 border-purple-400/30',
  tools: 'bg-cyan-600/30 text-cyan-200 border-cyan-400/30',
  vision: 'bg-fuchsia-600/30 text-fuchsia-200 border-fuchsia-400/30',
  coding: 'bg-emerald-600/30 text-emerald-200 border-emerald-400/30',
  audio: 'bg-amber-600/30 text-amber-200 border-amber-400/30',
  'long-context': 'bg-indigo-600/30 text-indigo-200 border-indigo-400/30',
};

const toSlug = (value) => value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');

const featureOptions = [
  ['reasoning', 'reasoning'],
  ['tools', 'tool use'],
  ['vision', 'vision'],
  ['coding', 'coding'],
  ['audio', 'audio'],
  ['longContext', 'long context'],
];

const MultiModelWorkspace = () => {
  const [models, setModels] = useState(defaultModels);
  const [selectedModelIds, setSelectedModelIds] = useState(['openai-gpt-5']);
  const [contexts, setContexts] = useState(starterConversations);
  const [selectedContextIds, setSelectedContextIds] = useState(['ctx-1']);
  const [appName, setAppName] = useState('Reasoning Copilot');
  const [apps, setApps] = useState([]);
  const [message, setMessage] = useState('');
  const [reasoningResults, setReasoningResults] = useState([]);
  const [notice, setNotice] = useState('');
  const [secretShare, setSecretShare] = useState(null);

  const [contextForm, setContextForm] = useState({ title: '', summary: '' });

  const [modelForm, setModelForm] = useState({
    provider: '',
    name: '',
    maxContext: 128000,
    reasoning: true,
    tools: true,
    vision: false,
    coding: false,
    audio: false,
    longContext: false,
  });

  useEffect(() => {
    const persisted = localStorage.getItem(STORAGE_KEY);
    if (!persisted) {
      return;
    }

    try {
      const parsed = JSON.parse(persisted);
      if (parsed.models?.length) {
        setModels(parsed.models);
      }
      if (parsed.contexts?.length) {
        setContexts(parsed.contexts);
      }
      if (parsed.apps?.length) {
        setApps(parsed.apps);
      }
    } catch {
      // ignore bad payload
    }
  }, []);

  useEffect(() => {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({
        models,
        contexts,
        apps,
      }),
    );
  }, [apps, contexts, models]);

  const selectedModels = useMemo(
    () => models.filter((model) => selectedModelIds.includes(model.id)),
    [models, selectedModelIds],
  );

  const selectedContexts = useMemo(
    () => contexts.filter((context) => selectedContextIds.includes(context.id)),
    [contexts, selectedContextIds],
  );

  const toggleSelection = (id, selectedValues, onChange) => {
    if (selectedValues.includes(id)) {
      onChange(selectedValues.filter((value) => value !== id));
      return;
    }

    onChange([...selectedValues, id]);
  };

  const addModel = (event) => {
    event.preventDefault();

    if (!modelForm.provider.trim() || !modelForm.name.trim()) {
      setNotice('Add both provider and model name.');
      return;
    }

    const features = featureOptions
      .filter(([key]) => modelForm[key])
      .map(([key]) => (key === 'longContext' ? 'long-context' : key));

    const id = `${toSlug(modelForm.provider)}-${toSlug(modelForm.name)}-${Date.now()}`;

    const newModel = {
      id,
      provider: modelForm.provider.trim(),
      name: modelForm.name.trim(),
      maxContext: Number(modelForm.maxContext) || 128000,
      features,
    };

    setModels((previous) => [newModel, ...previous]);
    setSelectedModelIds((previous) => [...new Set([id, ...previous])]);
    setNotice(`Added ${newModel.name} and selected it.`);
    setModelForm({
      provider: '',
      name: '',
      maxContext: 128000,
      reasoning: true,
      tools: true,
      vision: false,
      coding: false,
      audio: false,
      longContext: false,
    });
  };

  const addContext = (event) => {
    event.preventDefault();

    if (!contextForm.title.trim() || !contextForm.summary.trim()) {
      setNotice('Add both context title and summary.');
      return;
    }

    const newContext = {
      id: `ctx-${Date.now()}`,
      title: contextForm.title.trim(),
      summary: contextForm.summary.trim(),
    };

    setContexts((previous) => [newContext, ...previous]);
    setSelectedContextIds((previous) => [...new Set([newContext.id, ...previous])]);
    setContextForm({ title: '', summary: '' });
    setNotice(`Added context: ${newContext.title}`);
  };

  const createApp = () => {
    if (!appName.trim()) {
      setNotice('Name your app before creating it.');
      return;
    }

    if (selectedModels.length === 0) {
      setNotice('Select at least one model.');
      return;
    }

    const newApp = {
      id: `app-${Date.now()}`,
      name: appName.trim(),
      modelIds: selectedModels.map((model) => model.id),
      contextIds: selectedContexts.map((context) => context.id),
      createdAt: new Date().toLocaleString(),
    };

    setApps((previous) => [newApp, ...previous]);
    setNotice(`Created ${newApp.name}.`);
  };

  const runReasoningPass = () => {
    if (!message.trim()) {
      setNotice('Write a prompt to run reasoning.');
      return;
    }

    if (selectedModels.length === 0) {
      setNotice('Pick at least one model to run reasoning.');
      return;
    }

    const contextHint = selectedContexts.map((context) => context.title).join(', ') || 'no context';

    const responses = selectedModels.map((model) => ({
      modelId: model.id,
      modelName: model.name,
      provider: model.provider,
      content: `Using ${contextHint}, ${model.name} suggests: prioritize assumptions, compare trade-offs, and provide a concise action plan for "${message.trim()}".`,
    }));

    setReasoningResults(responses);
    setNotice(`Ran reasoning pass on ${responses.length} model(s).`);
  };

  const shareAppPrivately = (app) => {
    const token = Math.random().toString(36).slice(2, 8).toUpperCase();
    const passphrase = Math.random().toString(36).slice(-10);
    const payload = btoa(JSON.stringify({ appId: app.id, token }));

    setSecretShare({
      appName: app.name,
      link: `https://teamspace.local/share/${payload}`,
      passphrase,
      expiresIn: '24 hours',
    });
  };

  const copySecret = async () => {
    if (!secretShare) {
      return;
    }

    await navigator.clipboard.writeText(
      `${secretShare.link}\npassphrase: ${secretShare.passphrase}\nexpires: ${secretShare.expiresIn}`,
    );
    setNotice('Secret share copied to clipboard.');
  };

  const resolveNames = (ids, data) => data.filter((item) => ids.includes(item.id)).map((item) => item.title || item.name);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-6 md:p-10">
      <div className="max-w-7xl mx-auto space-y-6">
        <header className="bg-slate-900/70 border border-slate-800 rounded-2xl p-6">
          <div className="flex flex-wrap items-center gap-3 text-sm text-slate-300 mb-2">
            <Sparkles size={16} className="text-purple-300" />
            Multi-model orchestration workspace
          </div>
          <h1 className="text-3xl font-bold">Build one app with multiple AI models</h1>
          <p className="text-slate-300 mt-2">
            Add model configs, combine providers, reuse old chat context, run side-by-side reasoning,
            and share apps privately.
          </p>
          {notice && <p className="mt-3 text-sm text-emerald-300">{notice}</p>}
        </header>

        <div className="grid lg:grid-cols-3 gap-6">
          <section className="lg:col-span-2 bg-slate-900/70 border border-slate-800 rounded-2xl p-6 space-y-4">
            <div className="flex items-center justify-between">
              <h2 className="text-xl font-semibold flex items-center gap-2">
                <Brain size={18} /> Model catalog
              </h2>
              <span className="text-xs text-slate-400">Select one or many models</span>
            </div>

            <div className="space-y-3">
              {models.map((model) => {
                const isActive = selectedModelIds.includes(model.id);
                return (
                  <button
                    key={model.id}
                    onClick={() => toggleSelection(model.id, selectedModelIds, setSelectedModelIds)}
                    className={`w-full text-left rounded-xl border p-4 transition ${
                      isActive
                        ? 'border-purple-500 bg-purple-700/20'
                        : 'border-slate-700 hover:border-slate-500'
                    }`}
                  >
                    <div className="flex items-center justify-between gap-3">
                      <div>
                        <div className="font-semibold">{model.name}</div>
                        <div className="text-sm text-slate-300">{model.provider}</div>
                      </div>
                      <div className="text-right text-xs text-slate-300">
                        <div>{model.maxContext.toLocaleString()} tokens</div>
                        {isActive && (
                          <span className="inline-flex items-center gap-1 text-emerald-300 mt-1">
                            <Check size={12} /> selected
                          </span>
                        )}
                      </div>
                    </div>
                    <div className="mt-3 flex flex-wrap gap-2">
                      {model.features.map((feature) => (
                        <span
                          key={`${model.id}-${feature}`}
                          className={`border px-2 py-1 rounded-full text-xs ${tagColors[feature] || ''}`}
                        >
                          {feature}
                        </span>
                      ))}
                    </div>
                  </button>
                );
              })}
            </div>
          </section>

          <section className="bg-slate-900/70 border border-slate-800 rounded-2xl p-6 space-y-4">
            <h2 className="text-xl font-semibold flex items-center gap-2">
              <Plus size={18} /> Add model config
            </h2>

            <form className="space-y-3" onSubmit={addModel}>
              <input
                className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2"
                placeholder="Provider (e.g. OpenAI)"
                value={modelForm.provider}
                onChange={(event) => setModelForm({ ...modelForm, provider: event.target.value })}
              />
              <input
                className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2"
                placeholder="Model name"
                value={modelForm.name}
                onChange={(event) => setModelForm({ ...modelForm, name: event.target.value })}
              />
              <input
                type="number"
                min="1000"
                className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2"
                value={modelForm.maxContext}
                onChange={(event) => setModelForm({ ...modelForm, maxContext: event.target.value })}
              />

              <div className="grid grid-cols-2 gap-2 text-sm">
                {featureOptions.map(([key, label]) => (
                  <label key={key} className="flex items-center gap-2 rounded-lg bg-slate-800 px-2 py-1">
                    <input
                      type="checkbox"
                      checked={modelForm[key]}
                      onChange={(event) =>
                        setModelForm((previous) => ({
                          ...previous,
                          [key]: event.target.checked,
                        }))
                      }
                    />
                    {label}
                  </label>
                ))}
              </div>

              <button className="w-full rounded-lg bg-purple-600 hover:bg-purple-500 py-2 font-medium" type="submit">
                Save model
              </button>
            </form>
          </section>
        </div>

        <section className="bg-slate-900/70 border border-slate-800 rounded-2xl p-6">
          <div className="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h2 className="text-xl font-semibold flex items-center gap-2">
              <Settings size={18} /> App composer
            </h2>
            <span className="text-xs text-slate-400">Attach context + models into one app</span>
          </div>

          <div className="grid lg:grid-cols-2 gap-4">
            <div className="space-y-3">
              <label className="block text-sm text-slate-300">App name</label>
              <input
                className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2"
                value={appName}
                onChange={(event) => setAppName(event.target.value)}
              />

              <div className="space-y-2">
                <p className="text-sm text-slate-300">Past chat context</p>
                {contexts.map((context) => (
                  <button
                    key={context.id}
                    onClick={() =>
                      toggleSelection(context.id, selectedContextIds, setSelectedContextIds)
                    }
                    className={`w-full text-left border rounded-lg px-3 py-2 ${
                      selectedContextIds.includes(context.id)
                        ? 'border-emerald-500 bg-emerald-500/10'
                        : 'border-slate-700'
                    }`}
                  >
                    <div className="font-medium">{context.title}</div>
                    <div className="text-xs text-slate-300">{context.summary}</div>
                  </button>
                ))}
              </div>

              <form onSubmit={addContext} className="space-y-2 rounded-lg border border-slate-700 p-3">
                <p className="text-sm inline-flex items-center gap-2 text-slate-300">
                  <MessageSquare size={14} /> Add chat context
                </p>
                <input
                  className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2"
                  placeholder="Context title"
                  value={contextForm.title}
                  onChange={(event) => setContextForm({ ...contextForm, title: event.target.value })}
                />
                <textarea
                  className="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 h-20"
                  placeholder="Summary"
                  value={contextForm.summary}
                  onChange={(event) => setContextForm({ ...contextForm, summary: event.target.value })}
                />
                <button className="rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-2 text-sm" type="submit">
                  Save context
                </button>
              </form>

              <button
                onClick={createApp}
                className="rounded-lg bg-emerald-600 hover:bg-emerald-500 px-4 py-2 font-medium"
              >
                Create app with selected models
              </button>
            </div>

            <div className="space-y-3">
              <p className="text-sm text-slate-300">Quick reasoning prompt</p>
              <div className="rounded-xl border border-slate-700 bg-slate-800 p-3">
                <textarea
                  value={message}
                  onChange={(event) => setMessage(event.target.value)}
                  placeholder="Ask your multi-model app a question..."
                  className="w-full h-28 resize-none bg-transparent outline-none"
                />
                <div className="text-xs text-slate-400 mt-2">
                  Active models: {selectedModels.map((model) => model.name).join(', ') || 'none'}
                </div>
                <button
                  onClick={runReasoningPass}
                  className="mt-3 inline-flex items-center gap-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 px-3 py-2 text-sm font-medium"
                >
                  <Send size={14} /> Run reasoning pass
                </button>
              </div>

              <div className="rounded-xl border border-slate-700 p-3 text-sm text-slate-300">
                Context attached: {selectedContexts.map((context) => context.title).join(' • ') || 'none'}
              </div>

              {reasoningResults.length > 0 && (
                <div className="space-y-2">
                  {reasoningResults.map((result) => (
                    <div key={result.modelId} className="rounded-xl border border-slate-700 p-3 text-sm">
                      <p className="font-medium">{result.modelName} ({result.provider})</p>
                      <p className="text-slate-300 mt-1">{result.content}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>

        <section className="bg-slate-900/70 border border-slate-800 rounded-2xl p-6">
          <h2 className="text-xl font-semibold mb-4">Created apps</h2>

          {apps.length === 0 ? (
            <p className="text-slate-400">No apps yet. Create one to unlock private sharing.</p>
          ) : (
            <div className="space-y-3">
              {apps.map((app) => (
                <div key={app.id} className="border border-slate-700 rounded-xl p-4">
                  <div className="flex flex-wrap gap-2 items-center justify-between">
                    <div>
                      <div className="font-semibold">{app.name}</div>
                      <div className="text-xs text-slate-400">Created {app.createdAt}</div>
                    </div>
                    <button
                      onClick={() => shareAppPrivately(app)}
                      className="inline-flex items-center gap-2 rounded-lg bg-slate-700 hover:bg-slate-600 px-3 py-2 text-sm"
                    >
                      <Share2 size={14} /> Share secretly
                    </button>
                  </div>

                  <div className="mt-2 text-sm text-slate-300">
                    Models: {resolveNames(app.modelIds, models).join(', ')}
                  </div>
                  <div className="text-xs text-slate-400">
                    Context: {resolveNames(app.contextIds, contexts).join(', ') || 'none'}
                  </div>
                </div>
              ))}
            </div>
          )}

          {secretShare && (
            <div className="mt-4 border border-amber-500/40 bg-amber-500/10 rounded-xl p-4">
              <div className="font-semibold inline-flex items-center gap-2">
                <Lock size={16} /> Secret share created for {secretShare.appName}
              </div>
              <div className="text-sm mt-2 break-all">Link: {secretShare.link}</div>
              <div className="text-sm">Passphrase: {secretShare.passphrase}</div>
              <div className="text-xs text-slate-300 mt-1">Expires in {secretShare.expiresIn}</div>
              <button
                onClick={copySecret}
                className="mt-3 inline-flex items-center gap-2 rounded-lg bg-amber-600 hover:bg-amber-500 px-3 py-2 text-sm"
              >
                <Copy size={14} /> Copy secret share details
              </button>
            </div>
          )}
        </section>
      </div>
    </div>
  );
};

export default MultiModelWorkspace;
