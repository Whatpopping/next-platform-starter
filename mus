import React, { useMemo, useState } from 'react';
import {
  AlertTriangle,
  CheckCircle2,
  Cpu,
  Gauge,
  HardDrive,
  Monitor,
  ShieldCheck,
  SlidersHorizontal,
  Thermometer,
  Zap,
} from 'lucide-react';

const tweakCatalog = [
  {
    id: 'startup',
    title: 'Startup App Trim',
    impact: 'Boot time -28%',
    pro: 'Faster login and lower idle RAM usage.',
    con: 'Some helper apps may not auto-launch.',
  },
  {
    id: 'power',
    title: 'High Performance Power Plan',
    impact: 'FPS stability +12%',
    pro: 'Reduces frame-time spikes during gaming and rendering.',
    con: 'Higher power draw and fan noise under load.',
  },
  {
    id: 'background',
    title: 'Background Services Optimization',
    impact: 'CPU overhead -15%',
    pro: 'More resources available to foreground tasks.',
    con: 'Some sync tasks can run less frequently.',
  },
  {
    id: 'storage',
    title: 'Storage Cleanup + Cache Rebuild',
    impact: 'Disk latency -22%',
    pro: 'Improves app launch speed and frees space.',
    con: 'First launch after cleanup can be slightly slower.',
  },
  {
    id: 'visuals',
    title: 'Visual Effects Smart Tuning',
    impact: 'Desktop responsiveness +10%',
    pro: 'Cuts GPU overhead while preserving clean UI.',
    con: 'A few animations/transparency effects are reduced.',
  },
];

export default function PcOptimizerDashboard() {
  const [enabledTweaks, setEnabledTweaks] = useState(new Set(['startup', 'background', 'storage']));

  const toggleTweak = (id) => {
    setEnabledTweaks((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  const score = useMemo(() => {
    const base = 62;
    const gain = enabledTweaks.size * 7;
    return Math.min(100, base + gain);
  }, [enabledTweaks]);

  const riskLabel = score >= 88 ? 'Excellent' : score >= 76 ? 'Great' : 'Balanced';

  return (
    <main className="min-h-screen bg-slate-950 text-slate-100 p-6 md:p-10">
      <div className="max-w-6xl mx-auto space-y-8">
        <section className="rounded-3xl bg-gradient-to-r from-indigo-600 via-violet-600 to-fuchsia-600 p-[1px] shadow-2xl">
          <div className="rounded-3xl bg-slate-900/95 p-6 md:p-8">
            <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
              <div>
                <p className="text-violet-300 font-medium tracking-wide">PC OPTIMIZER SUITE</p>
                <h1 className="text-3xl md:text-4xl font-bold mt-2">PeakTune Performance Center</h1>
                <p className="text-slate-300 mt-3 max-w-2xl">
                  Visually pleasing, one-click guided optimization that maximizes performance while clearly showing the
                  pros and cons of each tweak.
                </p>
              </div>
              <div className="rounded-2xl bg-slate-800/90 border border-violet-400/30 px-6 py-5 min-w-[220px]">
                <div className="flex items-center gap-2 text-slate-300 text-sm"><Gauge size={16} /> Performance Score</div>
                <div className="text-4xl font-bold mt-2">{score}</div>
                <div className="text-emerald-300 mt-1 text-sm">Status: {riskLabel}</div>
              </div>
            </div>
          </div>
        </section>

        <section className="grid md:grid-cols-4 gap-4">
          {[
            { icon: Cpu, label: 'CPU Load', value: '31%', tone: 'text-cyan-300' },
            { icon: Thermometer, label: 'Temp', value: '67°C', tone: 'text-orange-300' },
            { icon: HardDrive, label: 'Disk Active', value: '18%', tone: 'text-emerald-300' },
            { icon: Monitor, label: 'GPU Memory', value: '46%', tone: 'text-fuchsia-300' },
          ].map((card) => (
            <article key={card.label} className="rounded-2xl bg-slate-900 border border-slate-800 p-4">
              <div className="flex items-center justify-between">
                <span className="text-slate-400 text-sm">{card.label}</span>
                <card.icon size={18} className={card.tone} />
              </div>
              <div className="text-2xl font-semibold mt-2">{card.value}</div>
            </article>
          ))}
        </section>

        <section className="rounded-3xl bg-slate-900 border border-slate-800 p-6">
          <div className="flex items-center gap-2 text-xl font-semibold mb-5"><SlidersHorizontal size={20} /> Recommended Tweaks</div>
          <div className="space-y-4">
            {tweakCatalog.map((tweak) => {
              const active = enabledTweaks.has(tweak.id);
              return (
                <article key={tweak.id} className="rounded-2xl border border-slate-800 bg-slate-950/60 p-4">
                  <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                      <h3 className="font-semibold text-lg">{tweak.title}</h3>
                      <p className="text-emerald-300 text-sm mt-1">Expected impact: {tweak.impact}</p>
                    </div>
                    <button
                      onClick={() => toggleTweak(tweak.id)}
                      className={`px-4 py-2 rounded-xl text-sm font-medium transition ${
                        active ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/40' : 'bg-slate-800 text-slate-300 border border-slate-700'
                      }`}
                    >
                      {active ? 'Enabled' : 'Enable'}
                    </button>
                  </div>
                  <div className="grid md:grid-cols-2 gap-3 mt-4 text-sm">
                    <div className="rounded-xl bg-emerald-500/10 border border-emerald-500/30 p-3 flex gap-2">
                      <CheckCircle2 size={16} className="text-emerald-300 mt-0.5" />
                      <span>{tweak.pro}</span>
                    </div>
                    <div className="rounded-xl bg-amber-500/10 border border-amber-500/30 p-3 flex gap-2">
                      <AlertTriangle size={16} className="text-amber-300 mt-0.5" />
                      <span>{tweak.con}</span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <section className="grid md:grid-cols-2 gap-4">
          <article className="rounded-2xl bg-slate-900 border border-slate-800 p-5">
            <h3 className="font-semibold flex items-center gap-2"><Zap size={18} className="text-violet-300" /> Auto-Boost Mode</h3>
            <p className="text-slate-300 mt-2 text-sm">
              Applies safe, reversible tweaks before gaming, editing, or streaming sessions and restores defaults after.
            </p>
          </article>
          <article className="rounded-2xl bg-slate-900 border border-slate-800 p-5">
            <h3 className="font-semibold flex items-center gap-2"><ShieldCheck size={18} className="text-emerald-300" /> Safety Snapshot</h3>
            <p className="text-slate-300 mt-2 text-sm">
              Every tweak is tracked with rollback points so you can revert instantly if behavior changes.
            </p>
          </article>
        </section>
      </div>
    </main>
  );
}
